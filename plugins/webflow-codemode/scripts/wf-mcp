#!/bin/sh
# Start the wf-mcp binary. It's built for Apple silicon Macs only.
dir=$(cd "$(dirname "$0")" && pwd)
bin="$dir/wf-mcp-darwin-arm64"
if [ "$(uname -s)" != "Darwin" ] || [ "$(uname -m)" != "arm64" ]; then
  echo "wf-mcp: the webflow-codemode plugin only runs on Macs with Apple silicon (M1 or later)." >&2
  exit 1
fi
# Check once per build that macOS lets the binary run, so a blocked binary gives a message instead of a bare exit
# code. .checked records the check; if this folder isn't writable, the check runs every time.
if [ ! "$dir/.checked" -nt "$bin" ]; then
  # Unpacking the plugin can drop the executable bits.
  [ -x "$bin" ] || chmod +x "$bin" "$dir/typescript-darwin-arm64/tsc" 2>/dev/null
  # The shell's own stderr is silenced too, or it prints a "Killed: 9" line of its own.
  exec 3>&2 2>/dev/null
  "$bin" --version >/dev/null
  status=$?
  exec 2>&3 3>&-
  if [ "$status" -ne 0 ]; then
    if [ "$status" -eq 126 ]; then why="it isn't executable"
    elif [ "$status" -gt 128 ]; then why="macOS stopped it (signal $((status - 128)))"
    else why="it exited with code $status"; fi
    echo "wf-mcp: the plugin's binary can't run, because $why. Reinstall the webflow-codemode plugin, and if that doesn't help, open an issue at https://github.com/wickedapps/webflow-mcp-codemode/issues." >&2
    exit 1
  fi
  touch "$dir/.checked" 2>/dev/null
fi
# Tells the binary it runs from the plugin, so its messages name slash commands (src/plugin.ts).
export WF_MCP_PLUGIN=1
exec "$bin" "$@"
